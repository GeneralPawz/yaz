# Machine-generated or vendored. Formatting these is at best churn and at worst
# corruption: a lockfile is regenerated by the package manager and has to match
# byte-for-byte what it produces, not what Prettier prefers.
pnpm-lock.yaml

# Build output.
dist/
target/
docs/.vitepress/dist/
docs/.vitepress/cache/

# Generated documentation. `scripts/generate-docs.mjs` owns these, so
# reformatting them means the next run produces a diff and CI fails on a file
# nobody edited.
docs/reference/generated/

# Test fixtures are inputs to the compiler, not source we style. A `.tex` or
# `.typ` file has no Prettier parser today, but pinning this now means adding
# one later cannot silently rewrite a fixture and change what it tests.
tests/fixtures/
