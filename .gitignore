# Rust
/target
# Any alternate cargo target directory. A second one is needed when the usual
# `target/` is locked by a running yaz — Windows will not let the linker replace
# a running executable — and forgetting to ignore it commits four thousand build
# artefacts.
/target-*/
**/target
Cargo.lock.bak

# Node
node_modules/
.pnpm-store/
dist/
.svelte-kit/
.vite/
*.tsbuildinfo

# Tauri
/crates/yaz-app/gen/schemas/
/crates/yaz-app/target/

# Docs site
/docs/.vitepress/dist/
/docs/.vitepress/cache/

# NOTE: docs/reference/generated/ is deliberately NOT ignored. ADR-0016 requires
# CI to fail when regenerating produces a diff, which only works if the
# generated output is committed and therefore comparable.

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Local dev state — see docs/adr/0013-update-distribution.md
/.yaz-dev/
/dev-vault/
/dev-plugins/
*.local
.env
.env.*
!.env.example

# Signing keys must never be committed
*.key
*.pem
tauri-private.key*

# Build/test artefacts
*.pdf
!assets/**/*.pdf
!docs/**/*.pdf
*.aux
*.log
*.out
*.synctex.gz
*.fdb_latexmk
*.fls
*.bbl
*.blg
*.xdv
tests/fixtures/**/build/
coverage/
