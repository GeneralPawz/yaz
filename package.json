{
  "name": "yaz-monorepo",
  "version": "0.2.0",
  "private": true,
  "description": "A modern LaTeX writing environment that connects Zotero and Obsidian to publishable papers.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GeneralPawz/yaz.git"
  },
  "homepage": "https://generalpawz.github.io/yaz",
  "bugs": "https://github.com/GeneralPawz/yaz/issues",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "tauri dev",
    "app:build": "tauri build",
    "app:build:tectonic": "tauri build -- --features tectonic-engine",
    "tauri": "tauri",
    "web:dev": "pnpm --filter @yaz/desktop dev",
    "web:build": "pnpm --filter @yaz/desktop build",
    "check": "pnpm -r check",
    "lint": "node scripts/check-plugin-imports.mjs && pnpm -r lint",
    "format": "prettier --write . && cargo fmt --all",
    "format:check": "prettier --check . && cargo fmt --all --check",
    "test": "pnpm -r test",
    "test:rust": "cargo test --workspace",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "test:rust:tectonic": "cargo test -p yaz-compile --features tectonic-engine",
    "docs:dev": "pnpm --filter @yaz/docs dev",
    "docs:build": "pnpm --filter @yaz/docs build",
    "docs:generate": "node scripts/generate-docs.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "lint:plugins": "node scripts/check-plugin-imports.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@tauri-apps/cli": "^2.1.0",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "typescript": "^6.0.0"
  }
}
