{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": false,
  "include-component-in-tag": true,
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "refactor", "section": "Refactoring", "hidden": true },
    { "type": "docs", "section": "Documentation", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "build", "section": "Build", "hidden": true },
    { "type": "ci", "section": "CI", "hidden": true },
    { "type": "chore", "section": "Chores", "hidden": true }
  ],
  "packages": {
    ".": {
      "component": "yaz",
      "_comment": "release-type is `node` rather than `rust` because the repository root is a VIRTUAL Cargo workspace with no [package] section, which the rust strategy rejects ('is not a package manifest'). The root package.json is a real manifest with a version, so it anchors the release; the Cargo and Tauri versions follow via extra-files.",
      "release-type": "node",
      "package-name": "yaz",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "type": "json",
          "path": "crates/yaz-app/tauri.conf.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/desktop/package.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "packages/api": {
      "component": "api",
      "release-type": "node",
      "package-name": "@yaz/api",
      "changelog-path": "CHANGELOG.md"
    }
  }
}
