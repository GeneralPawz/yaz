# Normalise line endings so Windows and Linux contributors do not fight.
* text=auto eol=lf

*.bat  text eol=crlf
*.ps1  text eol=crlf
*.cmd  text eol=crlf

*.png  binary
*.jpg  binary
*.ico  binary
*.icns binary
*.pdf  binary
*.woff binary
*.woff2 binary

# Generated — collapse in PR diffs
Cargo.lock            linguist-generated=true
pnpm-lock.yaml        linguist-generated=true
CHANGELOG.md          linguist-generated=true
docs/api/generated/** linguist-generated=true
